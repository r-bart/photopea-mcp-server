{
  "name": "photopea-mcp-server",
  "version": "0.2.0",
  "description": "MCP server for AI-driven image editing with Photopea",
  "author": "attalla1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r-bart/photopea-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/r-bart/photopea-mcp-server/issues"
  },
  "homepage": "https://github.com/r-bart/photopea-mcp-server#readme",
  "keywords": [
    "modelcontextprotocol",
    "mcp",
    "photopea",
    "image-editing",
    "ai"
  ],
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "src/frontend",
    "LICENSE",
    "README.md",
    "CHECKPOINTS.md"
  ],
  "bin": {
    "photopea-mcp-server": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node --input-type=module -e \"import { chmodSync } from 'node:fs'; chmodSync('dist/index.js', 0o755);\"",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx tests/e2e/isolated.ts",
    "typecheck": "tsc --noEmit -p tsconfig.tests.json && node --check src/frontend/client.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "open": "^10.1.0",
    "ws": "^8.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.0"
  }
}
